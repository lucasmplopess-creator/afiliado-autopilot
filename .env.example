# Porta do painel
PORT=3000
# Senha simples para proteger o painel (recomendado em produção)
PAINEL_SENHA=troque-esta-senha
TZ_APP=America/Sao_Paulo

# Shopee Afiliados (Open API). Pegue em affiliate.shopee.com.br > Open API
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_ENDPOINT=https://open-api.affiliate.shopee.com.br/graphql

# IA para as legendas (opcional; sem chave usa modelos prontos)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# WhatsApp via Evolution API (self-hosted)
EVOLUTION_URL=
EVOLUTION_APIKEY=
EVOLUTION_INSTANCE=

# Telegram Bot (crie com @BotFather)
TELEGRAM_BOT_TOKEN=

# Página do Facebook (Graph API oficial). Token de acesso da PÁGINA, de longa duração
FACEBOOK_PAGE_TOKEN=
FACEBOOK_API_VERSION=v23.0
